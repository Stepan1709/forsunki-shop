# syntax=docker/dockerfile:1.7
# Шаблон образа для сервисов на Python. Контекст сборки: корень репозитория.
#   docker build -f deploy/docker/Dockerfile.python --build-arg SERVICE=api -t forsunki-api .
# На этапе 1 от него наследуются Dockerfile конкретных сервисов (CMD и порт).

ARG PYTHON_VERSION=3.12.8

# --- Стадия сборки: зависимости ставим в venv, который потом копируем целиком ---
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder
COPY --from=ghcr.io/astral-sh/uv:0.5.14 /uv /usr/local/bin/uv
ARG SERVICE
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /srv/${SERVICE}
# Сначала только манифесты: слой с зависимостями переиспользуется, пока они не менялись.
COPY services/${SERVICE}/pyproject.toml services/${SERVICE}/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# --- Финальный образ: без uv, компиляторов и кэшей ---
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime
ARG SERVICE
ARG PORT=8000
ENV PATH="/srv/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Не root: компрометация процесса не даёт прав на файловую систему контейнера.
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home app
WORKDIR /srv/app
COPY --from=builder /srv/${SERVICE}/.venv ./.venv
COPY --chown=app:app services/${SERVICE}/app ./app
USER app
EXPOSE ${PORT}
# Проверяем сам процесс, а не порт снаружи. Эндпоинт /health/live появится на этапе 1.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request as u; u.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", \"8000\")}/health/live', timeout=2)"]
# Exec-форма: сигналы (SIGTERM) приходят самому процессу, а не оболочке, иначе нет graceful shutdown.
CMD ["python", "-c", "raise SystemExit('Шаблон: задайте CMD в Dockerfile сервиса')"]
