# Несекретные настройки. Копия лежит в .env (создаётся командой `make env`).
# Пароли здесь НЕ хранятся: они в deploy/secrets/dev/* (см. `make secrets`).

ENV=dev

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=forsunki
POSTGRES_DB=forsunki

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=forsunki

# Порт Postgres на хосте (dev). Меняйте, если занят.
POSTGRES_PUBLISH_PORT=5433

# Каталог с файлами секретов на хосте (монтируются в /run/secrets/<имя>)
SECRETS_DIR=./secrets/dev
